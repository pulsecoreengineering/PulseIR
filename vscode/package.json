{
  "name": "pulseir",
  "displayName": "PulseIR",
  "description": "YAML-to-C++ language support for PulseIR embedded state machines — diagnostics, syntax highlighting, and code generation",
  "version": "0.1.0",
  "publisher": "pulsecoreengineering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pulsecoreengineering/PulseIR"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "pulseir",
    "embedded",
    "arduino",
    "esp32",
    "state machine",
    "yaml"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "main": "./client/out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pulseir",
          "title": "PulseIR",
          "icon": "images/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "pulseir": [
        {
          "id": "pulseir.projectView",
          "name": "Project"
        },
        {
          "id": "pulseir.modelsView",
          "name": "Models"
        },
        {
          "id": "pulseir.driversView",
          "name": "Driver Plugins"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pulseir.modelsView",
        "contents": "No PulseIR models found in this workspace.\n\n[New Project](command:pulseir.newProject)\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "pulseir.projectView",
        "contents": "No PulseIR project open.\n\n[New Project](command:pulseir.newProject)"
      },
      {
        "view": "pulseir.driversView",
        "contents": "No driver plugins installed.\n\n[Install Plugin](command:pulseir.pluginInstall)"
      }
    ],
    "languages": [
      {
        "id": "pulseir",
        "aliases": ["PulseIR", "pulseir"],
        "extensions": [".pulse.yaml", ".pulse.yml"],
        "filenamePatterns": ["*.pulse.yaml", "*.pulse.yml"],
        "firstLine": "^pulseir:\\s",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pulseir",
        "scopeName": "source.pulseir",
        "path": "./syntaxes/pulseir.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pulseir.generate",
        "title": "PulseIR: Generate Code",
        "icon": "$(play)"
      },
      {
        "command": "pulseir.showDiagram",
        "title": "PulseIR: Show State Diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "pulseir.jumpToStub",
        "title": "PulseIR: Jump to Stub Implementation"
      },
      {
        "command": "pulseir.newProject",
        "title": "PulseIR: New Project",
        "icon": "$(add)"
      },
      {
        "command": "pulseir.refreshModels",
        "title": "PulseIR: Refresh Models",
        "icon": "$(refresh)"
      },
      {
        "command": "pulseir.generateForModel",
        "title": "PulseIR: Generate Code",
        "icon": "$(play)"
      },
      {
        "command": "pulseir.showDiagramForModel",
        "title": "PulseIR: Show Diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "pulseir.selectTarget",
        "title": "PulseIR: Select Target Framework"
      },
      {
        "command": "pulseir.toggleGenerateOnSave",
        "title": "PulseIR: Toggle Generate on Save"
      },
      {
        "command": "pulseir.pluginInstall",
        "title": "PulseIR: Install Driver Plugin",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pulseir.pluginRemove",
        "title": "PulseIR: Remove Driver Plugin",
        "icon": "$(trash)"
      },
      {
        "command": "pulseir.pluginList",
        "title": "PulseIR: List Driver Plugins"
      },
      {
        "command": "pulseir.refreshDrivers",
        "title": "PulseIR: Refresh Driver Plugins",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == pulseir",
          "command": "pulseir.generate",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == pulseir",
          "command": "pulseir.showDiagram",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "pulseir.newProject",
          "when": "view == pulseir.modelsView",
          "group": "navigation"
        },
        {
          "command": "pulseir.refreshModels",
          "when": "view == pulseir.modelsView",
          "group": "navigation"
        },
        {
          "command": "pulseir.pluginInstall",
          "when": "view == pulseir.driversView",
          "group": "navigation@1"
        },
        {
          "command": "pulseir.refreshDrivers",
          "when": "view == pulseir.driversView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "pulseir.generateForModel",
          "when": "view == pulseir.modelsView && viewItem == pulseirModel",
          "group": "inline@1"
        },
        {
          "command": "pulseir.showDiagramForModel",
          "when": "view == pulseir.modelsView && viewItem == pulseirModel",
          "group": "inline@2"
        },
        {
          "command": "pulseir.pluginRemove",
          "when": "view == pulseir.driversView && viewItem == pulseirDriver",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "PulseIR",
      "properties": {
        "pulseir.target": {
          "type": "string",
          "default": "arduino",
          "enum": ["arduino", "espidf", "zephyr", "micropython"],
          "description": "Default code generation target"
        },
        "pulseir.generateOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically generate code when a PulseIR file is saved"
        },
        "pulseir.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Output directory for generated files (default: same directory as the model file)"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.20.0",
    "@vscode/vsce": "^2.24.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "npm run build && vsce package",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  }
}
